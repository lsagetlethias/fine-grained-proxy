{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },
  "files": {
    "includes": [
      "**",
      "!docs/**",
      "!**/*.md",
      "!static/**",
      "!dist/**",
      "!presentation/**",
      "!node_modules/**",
      "!src/ui/client.ts",
      "!src/ui/client/**",
      "!src/ui/logs-client.ts",
      "!src/ui/changelog-data.ts",
      "!tailwind.config.js",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": { "enabled": true },
    "linter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": "off",
        "useAnchorContent": "off",
        "useAriaPropsSupportedByRole": "off",
        "useSemanticElements": "off"
      },
      "suspicious": {
        "useBiomeIgnoreFolder": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
