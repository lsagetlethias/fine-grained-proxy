{
  "name": "@fgp/proxy",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "build:css": "deno run -A npm:tailwindcss@3 -i src/ui/tailwind.css -o static/styles.css --minify",
    "build:client": "deno run -A npm:esbuild src/ui/client.ts src/ui/logs-client.ts --bundle --outdir=static --format=iife --minify --target=es2020",
    "build:version": "deno run --allow-run=git --allow-write=static/version.txt --allow-net=api.github.com --allow-env=FGP_GITHUB_REPO scripts/version.ts",
    "build:changelog": "deno run --allow-read=docs --allow-write=src/ui/changelog-data.ts scripts/changelog.ts",
    "build": "deno task build:css && deno task build:client && deno task build:version && deno task build:changelog",
    "dev:css": "deno run -A npm:tailwindcss@3 -i src/ui/tailwind.css -o static/styles.css --watch",
    "dev:client": "deno run -A npm:esbuild src/ui/client.ts src/ui/logs-client.ts --bundle --outdir=static --format=iife --watch",
    "dev:server": "deno run --watch --env-file --allow-net --allow-env=FGP_SALT,PORT,SCALINGO_API_URL,SCALINGO_AUTH_URL,FGP_LOGS_ENABLED,FGP_LOGS_BUFFER_NETWORK,FGP_LOGS_BUFFER_DETAILED,FGP_LOGS_INACTIVITY_MIN,FGP_LOGS_DETAILED_MAX_KB --allow-read=static src/main.ts",
    "dev": "deno run -A npm:concurrently --names css,client,server --prefix-colors yellow,blue,green 'deno task dev:css' 'deno task dev:client' 'deno task dev:server'",
    "start": "deno task build && deno run --env-file --allow-net --allow-env=FGP_SALT,PORT,SCALINGO_API_URL,SCALINGO_AUTH_URL,FGP_LOGS_ENABLED,FGP_LOGS_BUFFER_NETWORK,FGP_LOGS_BUFFER_DETAILED,FGP_LOGS_INACTIVITY_MIN,FGP_LOGS_DETAILED_MAX_KB --allow-read=static src/main.ts",
    "deploy": "deno task build && deployctl deploy --project=fgp-proxy --entrypoint=src/main.ts --include=src,static,deno.json,deno.lock",
    "test": "deno test --allow-net --allow-env=FGP_SALT,PORT,SCALINGO_API_URL,SCALINGO_AUTH_URL,FGP_LOGS_ENABLED,FGP_LOGS_BUFFER_NETWORK,FGP_LOGS_BUFFER_DETAILED,FGP_LOGS_INACTIVITY_MIN,FGP_LOGS_DETAILED_MAX_KB --allow-read=static tests/",
    "test:unit": "deno test --allow-env=FGP_SALT,PORT,SCALINGO_API_URL,SCALINGO_AUTH_URL,FGP_LOGS_ENABLED,FGP_LOGS_BUFFER_NETWORK,FGP_LOGS_BUFFER_DETAILED,FGP_LOGS_INACTIVITY_MIN,FGP_LOGS_DETAILED_MAX_KB --allow-read=static tests/testu/",
    "test:integration": "deno test --allow-net --allow-env=FGP_SALT,PORT,SCALINGO_API_URL,SCALINGO_AUTH_URL,FGP_LOGS_ENABLED,FGP_LOGS_BUFFER_NETWORK,FGP_LOGS_BUFFER_DETAILED,FGP_LOGS_INACTIVITY_MIN,FGP_LOGS_DETAILED_MAX_KB --allow-read=static tests/testi/",
    "test:e2e": "deno test --allow-net --allow-env=FGP_SALT,PORT,SCALINGO_API_URL,SCALINGO_AUTH_URL,FGP_LOGS_ENABLED,FGP_LOGS_BUFFER_NETWORK,FGP_LOGS_BUFFER_DETAILED,FGP_LOGS_INACTIVITY_MIN,FGP_LOGS_DETAILED_MAX_KB --allow-read=static tests/teste2e/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/main.ts src/middleware/*.ts src/crypto/*.ts src/auth/*.ts src/routes/*.tsx src/ui/*.tsx src/logs/*.ts tests/**/*.ts && deno task check:client",
    "check:client": "deno check --config deno.client.json src/ui/client.ts src/ui/logs-client.ts src/ui/client/*.ts",
    "verify": "deno task lint && deno task fmt:check && deno task check && deno task test"
  },
  "imports": {
    "hono": "npm:hono@^4.13.5",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.6.1",
    "zod": "npm:zod@^4.5.4",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.6.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [
      "docs/",
      "*.md",
      "static/",
      "src/ui/client.ts",
      "src/ui/client/",
      "src/ui/logs-client.ts",
      "src/ui/changelog-data.ts",
      "tailwind.config.*"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": [
      "docs/",
      "*.md",
      "static/",
      "tailwind.config.*",
      "src/ui/client.ts",
      "src/ui/client/",
      "src/ui/logs-client.ts",
      "src/ui/changelog-data.ts"
    ]
  },
  "exclude": [
    ".claude/",
    "node_modules/",
    "static/",
    "presentation/",
    "!presentation/demo.ts",
    "!presentation/demo-upstream/server.ts"
  ],
  "deploy": {
    "org": "lsagetlethias",
    "app": "fgp-proxy"
  }
}
