# Required
FGP_SALT=change-me-to-a-random-secret

# Optional
# PORT=8000
# SCALINGO_API_URL=https://api.osc-fr1.scalingo.com
# SCALINGO_AUTH_URL=https://auth.scalingo.com
# FGP_GITHUB_REPO=lsagetlethias/fine-grained-proxy

# Feature /logs (ADR-0007) : kill switch global, "1" pour activer
# FGP_LOGS_ENABLED=1
# FGP_LOGS_BUFFER_NETWORK=50
# FGP_LOGS_BUFFER_DETAILED=10
# FGP_LOGS_INACTIVITY_MIN=10
# FGP_LOGS_DETAILED_MAX_KB=32

# Interrupteur de DEVELOPPEMENT uniquement. A 1, la classification des adresses de
# destination est desactivee : G1 de l'ADR-0009 ne s'applique plus et l'instance
# redevient une SSRF non authentifiee, ouverte sur le reseau prive de l'hebergeur et
# sur son service de metadonnees. Ne jamais activer en production.
FGP_EGRESS_ALLOW_PRIVATE=0

# Nombre de sauts de proxy amont dignes de confiance pour lire X-Forwarded-For.
# 0 (defaut) : l'en-tete est ignore, l'IP vient de l'adresse du pair.
FGP_TRUSTED_PROXY_HOPS=0
